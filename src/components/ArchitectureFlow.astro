---
interface FlowItem {
  name: string;
  role?: string;
  note?: string;
}

interface FlowLayer {
  id: string;
  label: string;
  description?: string;
  items: FlowItem[];
}

interface FlowLink {
  from: string;
  to: string;
  label?: string;
}

interface Props {
  layers?: FlowLayer[];
  links?: FlowLink[];
  caption?: string;
}

const { layers = [], links = [], caption } = Astro.props;
const linkLabel = (from: string, to: string) =>
  links.find(link => link.from === from && link.to === to)?.label || '';
---

{layers.length > 0 && (
  <figure class="bg-[var(--bg-card)] border border-[var(--border)] rounded-card p-4 sm:p-6">
    <ol class="list-none space-y-0 p-0 m-0">
      {layers.map((layer, index) => (
        <li>
          {index > 0 && (
            <div class="flex justify-center py-2.5" aria-hidden="true">
              <div class="flex flex-col items-center gap-1">
                {linkLabel(layers[index - 1].id, layer.id) && (
                  <span class="font-mono text-[10px] text-[var(--text-dim)] uppercase tracking-wider text-center">
                    {linkLabel(layers[index - 1].id, layer.id)}
                  </span>
                )}
                <svg class="w-4 h-4 text-accent/60" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M8 2v11M4 9l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
            </div>
          )}

          <div class="rounded-card border border-[var(--border)] bg-[var(--bg-elevated)] p-4 hover:border-[var(--border-strong)] transition">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-3">
              <span class="font-mono text-[10px] text-accent border border-accent/30 bg-accent-dim rounded-badge px-2 py-0.5">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h4 class="text-sm font-semibold text-[var(--text)]">{layer.label}</h4>
              {layer.description && (
                <p class="text-xs text-[var(--text-dim)]">{layer.description}</p>
              )}
            </div>

            <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-2 list-none p-0 m-0">
              {layer.items.map(item => (
                <li class="rounded-btn border border-[var(--border)] bg-[var(--bg-card)] px-3 py-2">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-xs font-semibold text-[var(--text)]">{item.name}</span>
                    {item.role && (
                      <span class="font-mono text-[9px] text-[var(--text-dim)] uppercase tracking-wider">
                        {item.role}
                      </span>
                    )}
                  </div>
                  {item.note && (
                    <p class="font-mono text-[10px] text-[var(--text-dim)] mt-1 leading-relaxed">
                      {item.note}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
    {caption && (
      <figcaption class="text-[11px] text-[var(--text-dim)] mt-4">{caption}</figcaption>
    )}
  </figure>
)}
