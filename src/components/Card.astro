---
export interface Props {
  href?: string;
  class?: string;
  padding?: '4' | '5' | '6';
  hover?: boolean;
  children?: any;
}
const {
  href,
  class: className = '',
  padding = '5',
  hover = true,
  children,
} = Astro.props;

const pad = { '4': 'p-4', '5': 'p-5', '6': 'p-6' }[padding];
const base = `bg-[var(--bg-card)] border border-[var(--border)] rounded-card ${pad} transition-all duration-300 ${hover ? 'hover:border-[var(--border-strong)] hover:shadow-[0_8px_24px_-8px_var(--accent-dim)] -translate-y-1' : ''} ${className}`;
const Tag = href ? 'a' : 'div';
---
<Tag
  href={href}
  class={base}
  {...(href ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <slot />
</Tag>

<style>
  a { color: inherit; text-decoration: none; }
</style>
