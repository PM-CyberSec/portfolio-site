<div class="timeline">
  <div class="timeline-track" id="timelineTrack" aria-hidden="true"></div>
  {
    entries.map((entry, i) => (
      <div class="timeline-entry reveal-entry" data-type={entry.type} data-index={i}>
        <div class="timeline-marker">
          <span class="marker-dot"></span>
          <span class="marker-line" aria-hidden="true"></span>
        </div>
        <div class="timeline-card">
          <span class="timeline-year">{entry.year}</span>
          <h3 class="timeline-title">{entry.title}</h3>
          <span class="timeline-subtitle">{entry.subtitle}</span>
          <p class="timeline-desc">{entry.description}</p>
          <span class="timeline-badge" data-type={entry.type}>{entry.type}</span>
        </div>
      </div>
    ))
  }
</div>

<script>
  (function() {
    var entries = document.querySelectorAll('.reveal-entry');
    var track = document.getElementById('timelineTrack');

    function updateActive(index) {
      entries.forEach(function(el, i) {
        el.classList.toggle('active', i === index);
      });
      if (track) {
        var pct = entries.length > 1 ? (index / (entries.length - 1)) * 100 : 0;
        track.style.setProperty('--track-pct', pct + '%');
      }
    }

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function(entriesList) {
        entriesList.forEach(function(e) {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

      entries.forEach(function(el) {
        observer.observe(el);
      });
    } else {
      entries.forEach(function(el) { el.classList.add('visible'); });
    }

    var tlSection = document.getElementById('timeline');
    if (tlSection) {
      function updateOnScroll() {
        var tlRect = tlSection.getBoundingClientRect();
        var vh = window.innerHeight;
        /* only track when timeline is in view */
        if (tlRect.bottom < 0 || tlRect.top > vh) return;
        var sectionCenter = tlRect.top + tlRect.height / 2;
        var viewCenter = vh / 2;
        var closest = -1;
        var closestDist = Infinity;
        entries.forEach(function(el, i) {
          var rect = el.getBoundingClientRect();
          var entryCenter = rect.top + rect.height / 2;
          var dist = Math.abs(entryCenter - viewCenter);
          if (dist < closestDist) {
            closestDist = dist;
            closest = i;
          }
        });
        if (closest >= 0) updateActive(closest);
      }

      var tickingTl = false;
      window.addEventListener('scroll', function() {
        if (!tickingTl) {
          requestAnimationFrame(function() { updateOnScroll(); tickingTl = false; });
          tickingTl = true;
        }
      });
      updateOnScroll();
    }
  })();
</script>

<style>
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .timeline-track {
    position: absolute;
    left: 32px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, var(--color-border) 0%, var(--color-border) 100%);
    opacity: 0.3;
    transition: background 0.6s ease;
  }

  .timeline-track::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--track-pct, 0%);
    background: linear-gradient(180deg, var(--color-accent) 0%, var(--color-accent-dim) 100%);
    transition: height 0.6s ease;
  }

  .timeline-entry {
    display: flex;
    gap: 20px;
    position: relative;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s ease;
