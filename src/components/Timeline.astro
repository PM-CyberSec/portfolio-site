  .timeline-entry[data-index="5"].visible { transition-delay: 0.25s; }
  .timeline-entry[data-index="6"].visible { transition-delay: 0.3s; }
  .timeline-entry[data-index="7"].visible { transition-delay: 0.35s; }
  .timeline-entry[data-index="8"].visible { transition-delay: 0.4s; }
  .timeline-entry[data-index="9"].visible { transition-delay: 0.45s; }
  .timeline-entry[data-index="10"].visible { transition-delay: 0.5s; }
  .timeline-entry[data-index="11"].visible { transition-delay: 0.55s; }
  .timeline-entry[data-index="12"].visible { transition-delay: 0.6s; }
  .timeline-entry[data-index="13"].visible { transition-delay: 0.65s; }

