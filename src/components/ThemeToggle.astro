---
---

<button class="theme-btn" id="themeToggle" aria-label="Toggle colour theme" type="button">
  <span class="theme-indicator" aria-hidden="true"></span>
  <span class="theme-label" id="themeLabel">SOC</span>
  <span class="theme-icon" aria-hidden="true">&#x21C4;</span>
</button>

<script>
  const btn = document.getElementById('themeToggle');
  const label = document.getElementById('themeLabel');
  const root = document.documentElement;

  function setTheme(theme) {
    if (theme === 'htb') {
      root.setAttribute('data-theme', 'htb');
      label.textContent = 'HTB';
    } else {
      root.removeAttribute('data-theme');
      label.textContent = 'SOC';
    }
    try { localStorage.setItem('portfolio-theme', theme); } catch (e) {}
  }

  const saved = (function() { try { return localStorage.getItem('portfolio-theme'); } catch(e) {} })();
  if (saved === 'htb') {
    root.setAttribute('data-theme', 'htb');
    label.textContent = 'HTB';
  } else {
    label.textContent = 'SOC';
  }

  if (btn) {
    btn.addEventListener('click', function() {
      var current = root.getAttribute('data-theme');
      setTheme(current === 'htb' ? 'soc' : 'htb');
    });
  }
</script>

<style>
  .theme-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .theme-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    box-shadow: 0 0 15px var(--color-glow);
  }

  .theme-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .theme-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    transition: background 0.4s ease;
    flex-shrink: 0;
  }

  .theme-icon {
    font-size: 0.8rem;
    opacity: 0.5;
  }

  .theme-label {
    min-width: 28px;
    text-align: center;
  }
</style>
