---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import investigations from '../../data/investigations.json';
import blog from '../../data/blog.json';
import projects from '../../data/projects.json';
import { marked } from 'marked';

export function getStaticPaths() {
  return investigations.map(i => ({ params: { slug: i.slug } }));
}

const base = import.meta.env.BASE_URL;
const { slug } = Astro.params;
const investigation = investigations.find(i => i.slug === slug);

if (!investigation) {
  return Astro.redirect(`${base}/investigations`);
}

// Build lookup for [[slug]] internal links
const allItems = [
  ...blog.map(b => ({ ...b, _type: 'blog', _url: `${base}/blog/${b.slug}` })),
  ...projects.map(p => ({ ...p, _type: 'project', _url: `${base}/projects/${p.slug}` })),
  ...investigations.map(i => ({ ...i, _type: 'investigation', _url: `${base}/investigations/${i.slug}` })),
];

function processInternalLinks(md) {
  return md.replace(/\[\[([^\]]+)\]\]/g, (match, ref) => {
    const item = allItems.find(i => i.slug === ref || i.title === ref);
    if (item) return `[${item.title}](${item._url})`;
    return `[${ref}](${base})`;
  });
}

let reportContent = investigation.reportContent || '';
if (reportContent.startsWith('---')) {
  const end = reportContent.indexOf('---', 3);
  if (end !== -1) reportContent = reportContent.substring(end + 3).trim();
}
const reportHtml = marked.parse(processInternalLinks(reportContent));

const relatedProjects = investigation.relatedProjects?.length
  ? projects.filter(p => investigation.relatedProjects.includes(p.slug))
  : [];
const relatedBlogs = investigation.relatedBlogs?.length
  ? blog.filter(b => investigation.relatedBlogs.includes(b.slug))
  : [];
---
<Layout title={`${investigation.title} · Investigations`} description={investigation.summary}>
  <Nav />

  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-24">
    <div class="flex items-center gap-2 text-xs text-[var(--text-dim)] mb-6">
      <a href={base} class="hover:text-accent transition">Profile</a>
      <span>/</span>
      <a href={`${base}/investigations`} class="hover:text-accent transition">Investigations</a>
      <span>/</span>
      <span class="text-[var(--text-muted)]">{investigation.title}</span>
    </div>

    <div class="flex items-center gap-2 mb-4">
      <span class="text-[10px] px-2 py-0.5 bg-accent/20 text-accent border border-accent/30 rounded-badge">{investigation.category}</span>
      <span class="text-[10px] text-[var(--text-dim)]">{investigation.date}</span>
    </div>

    <h1 class="text-3xl font-bold text-[var(--text)] mb-3">{investigation.title}</h1>
    <p class="text-[var(--text-muted)] text-sm mb-8">{investigation.summary}</p>

    <!-- Tabs -->
    <div class="flex gap-1 border-b border-[var(--border)] mb-8">
      <button class="tab-btn text-sm px-4 py-2 text-accent border-b-2 border-accent -mb-px" data-tab="overview">Overview</button>
      {reportContent.trim() && <button class="tab-btn text-sm px-4 py-2 text-[var(--text-dim)] border-b-2 border-transparent" data-tab="report">Full Report</button>}
      {investigation.pdf && <button class="tab-btn text-sm px-4 py-2 text-[var(--text-dim)] border-b-2 border-transparent" data-tab="pdf">PDF Report</button>}
    </div>

    <!-- Tab: Overview -->
    <div id="tab-overview" class="tab-content">
      <div class="space-y-6">
        <div>
          <h3 class="text-accent text-xs font-mono uppercase tracking-wider mb-2">Scenario</h3>
          <p class="text-sm text-[var(--text-muted)]">{investigation.scenario}</p>
        </div>
        <div>
          <h3 class="text-accent text-xs font-mono uppercase tracking-wider mb-2">Objective</h3>
          <p class="text-sm text-[var(--text-muted)]">{investigation.objective}</p>
        </div>
        <div>
          <h3 class="text-accent text-xs font-mono uppercase tracking-wider mb-2">Environment</h3>
          <div class="flex flex-wrap gap-2">
            {investigation.environment.map(e => (
              <span class="text-xs px-2.5 py-1 border border-[var(--border)] rounded-badge text-[var(--text-muted)] bg-[var(--bg-elevated)]">{e}</span>
            ))}
          </div>
        </div>
        <div>
          <h3 class="text-accent text-xs font-mono uppercase tracking-wider mb-2">Key Findings</h3>
          <ul class="space-y-2">
            {investigation.keyFindings.map(f => (
              <li class="text-sm text-[var(--text-muted)] flex gap-2">
                <span class="text-accent mt-1 flex-shrink-0">&#x25B8;</span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-accent text-xs font-mono uppercase tracking-wider mb-2">MITRE ATT&CK</h3>
          <div class="flex flex-wrap gap-2">
            {investigation.mitreTechniques.map(t => (
              <span class="text-xs px-2.5 py-1 border border-accent/30 rounded-badge text-accent bg-accent-dim font-mono">{t}</span>
            ))}
          </div>
        </div>
        <div>
          <h3 class="text-accent text-xs font-mono uppercase tracking-wider mb-2">Tools Used</h3>
          <div class="flex flex-wrap gap-2">
            {investigation.tools.map(t => (
              <span class="text-xs px-2.5 py-1 border border-[var(--border)] rounded-badge text-[var(--text-muted)] bg-[var(--bg-elevated)]">{t}</span>
            ))}
          </div>
        </div>
        <div>
          <h3 class="text-accent text-xs font-mono uppercase tracking-wider mb-2">Outcome</h3>
          <p class="text-sm text-[var(--text-muted)]">{investigation.outcome}</p>
        </div>
      </div>
    </div>

    <!-- Tab: Report -->
    {reportContent.trim() && (
      <div id="tab-report" class="tab-content hidden">
        <div class="bg-[var(--bg-card)] border border-[var(--border)] rounded-card p-6 prose" set:html={reportHtml} />
      </div>
    )}

    <!-- Tab: PDF -->
    {investigation.pdf && (
      <div id="tab-pdf" class="tab-content hidden">
        <div class="bg-[var(--bg-card)] border border-[var(--border)] rounded-card overflow-hidden">
          <iframe src={investigation.pdf} class="w-full" style="height:80vh" title="PDF Report"></iframe>
        </div>
        <p class="text-xs text-[var(--text-dim)] mt-3 text-center">
          <a href={investigation.pdf} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition">Open PDF in new tab &rarr;</a>
        </p>
      </div>
    )}

    {(relatedProjects.length > 0 || relatedBlogs.length > 0) && (
      <div class="mt-12 pt-8 border-t border-[var(--border)]">
        {relatedProjects.length > 0 && (
          <div class="mb-6">
            <h3 class="text-sm font-semibold text-[var(--text)] mb-3">Related Projects</h3>
            <div class="grid sm:grid-cols-2 gap-3">
              {relatedProjects.map(p => (
                <a href={`${base}/projects/${p.slug}`} class="group block bg-[var(--bg-card)] border border-[var(--border)] rounded-card p-4 hover:border-[var(--border-strong)] transition">
                  <h4 class="text-sm font-semibold text-[var(--text)] group-hover:text-accent transition">{p.title}</h4>
                  <p class="text-xs text-[var(--text-dim)]">{p.role} · {p.timeline}</p>
                </a>
              ))}
            </div>
          </div>
        )}
        {relatedBlogs.length > 0 && (
          <div>
            <h3 class="text-sm font-semibold text-[var(--text)] mb-3">Related Articles</h3>
            <div class="grid sm:grid-cols-2 gap-3">
              {relatedBlogs.map(b => (
                <a href={`${base}/blog/${b.slug}`} class="group block bg-[var(--bg-card)] border border-[var(--border)] rounded-card p-4 hover:border-[var(--border-strong)] transition">
                  <h4 class="text-sm font-semibold text-[var(--text)] group-hover:text-accent transition">{b.title}</h4>
                  <p class="text-xs text-[var(--text-dim)]">{b.readingTime} min · {b.category}</p>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    )}
  </article>

  <Footer />
</Layout>

<script is:inline>
document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tab-btn').forEach(b => {
      b.classList.remove('text-accent', 'border-accent');
      b.classList.add('text-[var(--text-dim)]', 'border-transparent');
    });
    btn.classList.add('text-accent', 'border-accent');
    btn.classList.remove('text-[var(--text-dim)]', 'border-transparent');
    document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
    document.getElementById(`tab-${btn.dataset.tab}`)?.classList.remove('hidden');
  });
});
</script>

<style is:global>
.prose { color: var(--text-muted); line-height: 1.75; }
.prose h1 { font-size: 1.75rem; font-weight: 700; color: var(--text); margin: 1.5rem 0 0.75rem; }
.prose h2 { font-size: 1.5rem; font-weight: 700; color: var(--text); margin: 1.5rem 0 0.75rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; }
.prose h3 { font-size: 1.25rem; font-weight: 600; color: var(--text); margin: 1.25rem 0 0.5rem; }
.prose p { margin: 0.75rem 0; }
.prose a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
.prose a:hover { opacity: 0.8; }
.prose ul, .prose ol { margin: 0.75rem 0; padding-left: 1.5rem; }
.prose li { margin: 0.25rem 0; }
.prose li::marker { color: var(--accent); }
.prose pre { background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; overflow-x: auto; margin: 1rem 0; }
.prose code { font-family: 'JetBrains Mono', monospace; font-size: 0.85em; background: var(--bg); padding: 0.15em 0.4em; border-radius: 4px; border: 1px solid var(--border); }
.prose pre code { background: none; border: none; padding: 0; }
.prose blockquote { border-left: 3px solid var(--accent); padding-left: 1rem; margin: 1rem 0; color: var(--text-dim); font-style: italic; }
.prose table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
.prose th, .prose td { border: 1px solid var(--border); padding: 0.5rem 0.75rem; text-align: left; }
.prose th { background: var(--bg-elevated); font-weight: 600; color: var(--text); }
.prose hr { border: none; border-top: 1px solid var(--border); margin: 1.5rem 0; }
.prose img { max-width: 100%; height: auto; border-radius: 8px; margin: 1rem 0; border: 1px solid var(--border); }
</style>
