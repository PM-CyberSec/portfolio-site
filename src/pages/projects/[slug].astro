---
import Layout from '../../layouts/Layout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import ProjectTabs from '../../components/ProjectTabs.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} · Paula Maged`}>
  <main class="detail-page">
    <nav class="back-nav">
      <a href={import.meta.env.BASE_URL} class="back-link" onclick="sessionStorage.setItem('scrollTo','projects')">
        <span aria-hidden="true">&larr;</span> back to projects
      </a>
    </nav>

    <header class="detail-header">
      <div class="detail-meta">
        <StatusBadge label="SEVERITY" value={project.severity.toUpperCase()} variant={project.severity === 'critical' ? 'danger' : project.severity === 'high' ? 'warning' : 'accent'} pulse={project.severity === 'critical'} />
        <StatusBadge label="TIMELINE" value={project.timeline} variant="info" />
      </div>
      <h1 class="detail-title">{project.title}</h1>
      <p class="detail-objective">{project.objective}</p>

      {project.github && (
        <a href={project.github} class="detail-github" target="_blank" rel="noopener noreferrer">
          <span aria-hidden="true">&#x2387;</span> view on github
        </a>
      )}
    </header>

    <ProjectTabs project={project} />

    {project.team && (
      <div class="detail-section">
        <h2 class="detail-section-title">&#x25B8; strike_team</h2>
        <div class="team-grid">
          {project.team.map((m) => (
            <div class="team-card">
              <div class="team-name">{m.name}</div>
              <div class="team-role">{m.role}</div>
              <div class="team-resp">{m.responsibilities}</div>
            </div>
          ))}
        </div>
      </div>
    )}

    {project.branches && (
      <div class="detail-section">
        <h2 class="detail-section-title">&#x25B8; repository_branches</h2>
        <div class="branches-list">
          {project.branches.map((b) => (
            <div class="branch-item">
              {project.github
                ? <a href={project.github + '/tree/' + b.name} class="branch-link" target="_blank" rel="noopener noreferrer">
                    <span class="branch-name">{b.name}</span>
                    <span class="branch-desc">{b.description}</span>
                    {b.files && b.files.length > 0 && (
                      <span class="branch-files">{b.files.join(' \u00B7 ')}</span>
                    )}
                  </a>
                : <>
                    <span class="branch-name">{b.name}</span>
                    <span class="branch-desc">{b.description}</span>
                    {b.files && b.files.length > 0 && (
                      <span class="branch-files">{b.files.join(' \u00B7 ')}</span>
                    )}
                  </>
              }
            </div>
          ))}
        </div>
      </div>
    )}
  </main>
</Layout>

<style>
  .detail-page {
    padding: 32px 0;
  }

  .back-nav { margin-bottom: 24px; }

  .back-link {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: all 0.3s;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .back-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .detail-header { margin-bottom: 32px; }

  .detail-meta {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .detail-title {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 12px;
    letter-spacing: -0.5px;
  }

  .detail-objective {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 720px;
    font-weight: 300;
  }

  .detail-github {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.7rem;
    color: var(--color-accent);
    text-decoration: none;
    padding: 6px 14px;
    border: 1px solid var(--color-accent);
    border-radius: 4px;
    margin-top: 16px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.3s;
  }

  .detail-github:hover {
    background: var(--color-accent-dim);
    box-shadow: 0 0 12px var(--color-glow);
  }

  .detail-section {
    margin-top: 24px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 20px;
    transition: border 0.3s;
  }

  .detail-section:hover {
    border-color: var(--color-accent);
  }

  .detail-section-title {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 12px;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 10px;
  }

  .team-card {
    padding: 12px;
    background: rgba(0, 0, 0, 0.15);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    transition: all 0.3s;
  }

  .team-card:hover {
    border-color: var(--color-accent);
    background: rgba(0, 0, 0, 0.25);
  }

  .team-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .team-role {
    font-size: 0.6rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin: 2px 0 6px;
  }

  .team-resp {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    font-weight: 300;
    line-height: 1.4;
  }

  .branches-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .branch-item {
    font-size: 0.72rem;
    border-radius: 4px;
    transition: background 0.2s;
  }

  .branch-item:hover { background: rgba(0, 0, 0, 0.15); }

  .branch-link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    padding: 8px 10px;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s;
  }

  .branch-link:hover {
    color: var(--color-accent);
  }

  .branch-link:hover .branch-name {
    color: var(--color-accent);
  }

  .branch-name {
    font-weight: 600;
    color: var(--color-primary);
    flex-shrink: 0;
    min-width: 140px;
    transition: color 0.2s;
  }

  .branch-desc {
    color: var(--color-text-muted);
    font-weight: 300;
  }

  .branch-link:hover .branch-desc {
    color: var(--color-text);
  }

  .branch-files {
    display: block;
    width: 100%;
    font-size: 0.6rem;
    color: var(--color-text-dim);
    font-weight: 300;
    letter-spacing: 0.2px;
    padding: 2px 0 0 0;
    word-break: break-all;
  }

  .branch-link:hover .branch-files {
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .detail-title { font-size: 1.2rem; }
    .team-grid { grid-template-columns: 1fr; }
    .branch-name { min-width: 100px; font-size: 0.65rem; }
  }
</style>
