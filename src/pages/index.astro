---
import Layout from '../layouts/Layout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import TerminalTyping from '../components/TerminalTyping.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import StatusBadge from '../components/StatusBadge.astro';
import SubjectDossier from '../components/SubjectDossier.astro';
import SkillsMatrix from '../components/SkillsMatrix.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SystemUpdate from '../components/SystemUpdate.astro';
import Timeline from '../components/Timeline.astro';
import RickReveal from '../components/RickReveal.astro';
import { projects } from '../data/projects';
---

<Layout title="Paula Maged · Junior Cybersecurity Portfolio">
  <main>
    <!-- NAV -->
    <nav class="nav" aria-label="Primary navigation">
      <div class="nav-inner">
        <a href="#" class="nav-brand">Paula Maged</a>
        <div class="nav-links">
          <a href="#about" class="nav-link">/about</a>
          <a href="#skills" class="nav-link">/toolkit</a>
          <a href="#timeline" class="nav-link">/path</a>
          <a href="#projects" class="nav-link">/projects</a>
          <a href="#status" class="nav-link">/status</a>
          <a href="#contact" class="nav-link">/contact</a>
        </div>
        <ThemeToggle />
      </div>
    </nav>

    <!-- SECTION 1: HEADER / TERMINAL BOOT -->
    <header class="section" id="top">
      <div class="hero-split">
        <RickReveal name="Paula Maged" title="Junior Cybersecurity Analyst" />

        <div class="hero-terminal">
          <TerminalWindow title="GUEST_TERMINAL://boot_sequence" glow={true}>
            <TerminalTyping />
          </TerminalWindow>

          <div class="badge-strip">
            <StatusBadge label="STATUS" value="ACTIVE" variant="success" pulse={true} />
            <StatusBadge label="CLASSIFICATION" value="OPEN TO WORK" variant="warning" />
            <StatusBadge label="ROLE" value="JUNIOR CYBERSECURITY" variant="info" />
            <StatusBadge label="LOCATION" value="CAIRO, EGYPT" variant="info" />
            <StatusBadge label="CGPA" value="4.1 / 4.3" variant="accent" />
          </div>

          <div class="contact-strip">
            <a href="https://github.com/PM-CyberSec" class="contact-link" target="_blank" rel="noopener noreferrer">
              <span class="contact-icon" aria-hidden="true">&#x2387;</span> github
            </a>
            <a href="https://linkedin.com/in/paula-maged-04a721249" class="contact-link" target="_blank" rel="noopener noreferrer">
              <span class="contact-icon" aria-hidden="true">&#x25C8;</span> linkedin
            </a>
            <a href="mailto:paulamagedcyber@gmail.com" class="contact-link">
              <span class="contact-icon" aria-hidden="true">&#x2709;</span> email
            </a>
            <a href="tel:+201289990678" class="contact-link">
              <span class="contact-icon" aria-hidden="true">&#x260E;</span> phone
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- SECTION 2: ABOUT -->
    <section class="section" id="about">
      <div class="section-header">
        <span class="section-number">01</span>
        <h2 class="section-title">subject_dossier</h2>
      </div>
      <SubjectDossier />
    </section>

    <!-- SECTION 3: SKILLS -->
    <section class="section" id="skills">
      <div class="section-header">
        <span class="section-number">02</span>
        <h2 class="section-title">toolkit_decrypted</h2>
      </div>
      <SkillsMatrix />
    </section>

    <!-- STATS ROW -->
    <div class="stats-row">
      <div class="stat-cell">
        <span class="stat-number">11</span>
        <span class="stat-desc">project branches</span>
      </div>
      <div class="stat-cell">
        <span class="stat-number">4.1</span>
        <span class="stat-desc">CGPA / 4.3</span>
      </div>
      <div class="stat-cell">
        <span class="stat-number">2</span>
        <span class="stat-desc">society boards</span>
      </div>
      <div class="stat-cell">
        <span class="stat-number">3</span>
        <span class="stat-desc">languages spoken</span>
      </div>
    </div>

    <div class="metrics-card">
      <img
        src="https://portfolio-metrics-eight.vercel.app/api?username=PM-CyberSec&show_icons=true&theme=dark&bg_color=001F4D&title_color=00FFCC&text_color=FFFFFF&icon_color=00FFCC&border_color=00FFCC"
        alt="Live Cyber Telemetry"
        class="metrics-img"
        loading="lazy"
      />
    </div>

    <!-- SECTION 4: TIMELINE -->
    <section class="section" id="timeline">
      <div class="section-header">
        <span class="section-number">04</span>
        <h2 class="section-title">development_path</h2>
        <span class="section-meta">// 14 milestones</span>
      </div>
      <Timeline />
    </section>

    <!-- SECTION 5: PROJECTS -->
    <section class="section" id="projects">
      <div class="section-header">
        <span class="section-number">05</span>
        <h2 class="section-title">projects_built</h2>
        <span class="section-meta">// 11 branches</span>
      </div>

      <div class="projects-toolbar">
        <label class="search-box">
          <span class="search-icon" aria-hidden="true">&#x2315;</span>
          <input type="text" class="search-input" id="projectSearch" placeholder="filter projects by name, tech, or tag..." />
          <span class="search-hint" aria-hidden="true">ESC to clear</span>
        </label>
        <span class="search-count" id="projectCount">{projects.length} of {projects.length}</span>
      </div>

      <div class="projects-grid" id="projectGrid">
        {
          projects.map((project) => (
            <ProjectCard
              title={project.title}
              objective={project.objective}
              tags={project.tags}
              severity={project.severity}
              timeline={project.timeline}
              stack={project.stack}
              details={project.details}
              href={`${import.meta.env.BASE_URL}projects/${project.slug}`}
            />
          ))
        }
      </div>
    </section>

    <!-- SECTION 6: SYSTEM UPDATE -->
    <section class="section" id="status">
      <div class="section-header">
        <span class="section-number">06</span>
        <h2 class="section-title">system_update</h2>
      </div>
      <SystemUpdate />
    </section>

    <!-- CONTACT -->
    <section class="section" id="contact">
      <div class="section-header">
        <span class="section-number">07</span>
        <h2 class="section-title">contact_signals</h2>
      </div>

      <div class="contact-section">
        <p class="contact-intro">Open to cybersecurity opportunities, collaboration, and research discussions.</p>

        <div class="contact-layout">
          <div class="contact-channels">
          <a href="mailto:paulamagedcyber@gmail.com" class="channel-card">
            <span class="channel-icon" aria-hidden="true">&#x2709;</span>
            <span class="channel-label">email</span>
            <span class="channel-value">paulamagedcyber@gmail.com</span>
          </a>

          <a href="https://github.com/PM-CyberSec" class="channel-card" target="_blank" rel="noopener noreferrer">
            <span class="channel-icon" aria-hidden="true">&#x2387;</span>
            <span class="channel-label">github</span>
            <span class="channel-value">PM-CyberSec</span>
          </a>

          <a href="https://linkedin.com/in/paula-maged-04a721249" class="channel-card" target="_blank" rel="noopener noreferrer">
            <span class="channel-icon" aria-hidden="true">&#x25C8;</span>
            <span class="channel-label">linkedin</span>
            <span class="channel-value">paula-maged-04a721249</span>
          </a>

          <a href="tel:+201289990678" class="channel-card">
            <span class="channel-icon" aria-hidden="true">&#x260E;</span>
            <span class="channel-label">phone</span>
            <span class="channel-value">+20 128 999 0678</span>
          </a>

          <div class="channel-card location-card">
            <span class="channel-icon" aria-hidden="true">&#x25CB;</span>
            <span class="channel-label">location</span>
            <span class="channel-value">Cairo, Egypt</span>
          </div>
        </div>

        <form class="message-form" id="contactForm" action="https://formsubmit.co/paulamagedcyber@gmail.com" method="POST">
          <h3 class="form-title">&#x25B8; send_message</h3>
          <div class="form-row">
            <label class="form-field">
              <span class="form-label">name</span>
              <input type="text" name="name" required class="form-input" placeholder="your name" />
            </label>
            <label class="form-field">
              <span class="form-label">email</span>
              <input type="email" name="email" required class="form-input" placeholder="your email" />
            </label>
          </div>
          <label class="form-field">
            <span class="form-label">subject</span>
            <input type="text" name="subject" class="form-input" placeholder="subject" />
          </label>
          <label class="form-field">
            <span class="form-label">message</span>
            <textarea name="message" required class="form-input form-textarea" placeholder="type your message..." rows="4"></textarea>
          </label>
          <input type="hidden" name="_next" value="https://PM-CyberSec.github.io/portfolio-site/" />
          <input type="hidden" name="_captcha" value="true" />
          <input type="text" name="_honey" style="display:none" />
          <button type="submit" class="form-submit">
            <span aria-hidden="true">&#x25B8;</span> transmit
          </button>
        </form>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
      <div class="footer-divider" aria-hidden="true">
        <span>-----END OF TRANSMISSION-----</span>
      </div>
      <p class="footer-text">
        <span class="footer-accent">Paula Maged Habib Basta</span>
        <span class="footer-sep" aria-hidden="true">//</span>
        Junior Cybersecurity Professional
        <span class="footer-sep" aria-hidden="true">//</span>
        <span id="footerYear"></span>
      </p>
      <p class="footer-sub">
        IEEE &amp; AESS Board Member &#x25C8; El Sewedy University of Technology
      </p>
    </footer>
  </main>
</Layout>

<script>
  document.getElementById('footerYear').textContent = new Date().getFullYear();

  var search = document.getElementById('projectSearch');
  var grid = document.getElementById('projectGrid');
  var count = document.getElementById('projectCount');
  if (search && grid) {
    var cards = grid.querySelectorAll('.project-card');
    search.addEventListener('input', function() {
      var q = search.value.toLowerCase().trim();
      var visible = 0;
      cards.forEach(function(c) {
        var match = !q || c.textContent.toLowerCase().indexOf(q) !== -1;
        c.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      if (count) count.textContent = visible + ' of ' + cards.length;
    });
    search.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') { search.value = ''; search.dispatchEvent(new Event('input')); search.blur(); }
    });
  }
</script>

<style>
  main {
    padding-top: 0;
    padding-bottom: 40px;
  }

  /* NAVIGATION */
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg-elevated);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: all 0.3s ease;
    margin: 0 -24px;
    padding: 0 24px;
  }

  @media (min-width: 768px) {
    .nav { margin: 0 -48px; padding: 0 48px; }
  }

  @media (min-width: 1024px) {
    .nav { margin: 0 -64px; padding: 0 64px; }
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    max-width: 1200px;
    margin: 0 auto;
  }

  .nav-brand {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
    letter-spacing: -0.5px;
    transition: color 0.3s;
    flex-shrink: 0;
  }

  .nav-brand:hover { color: var(--color-text); }

  .nav-links {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .nav-link {
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 6px 12px;
    border-radius: 4px;
    transition: all 0.3s ease;
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }

  .nav-link:hover {
    color: var(--color-accent);
    background: var(--color-accent-dim);
  }

  /* SECTIONS */
  .hero-split {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .hero-terminal {
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 767px) {
    .hero-split {
      flex-direction: column;
      gap: 24px;
    }
  }

  .section {
    padding: 48px 0;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .section-number {
    font-size: 0.6rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 1.5px;
    opacity: 0.6;
  }

  .section-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin: 0;
  }

  .section-meta {
    font-size: 0.6rem;
    color: var(--color-text-dim);
    letter-spacing: 0.5px;
  }

  /* BADGE STRIP */
  .badge-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  /* CONTACT STRIP */
  .contact-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 16px;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 6px 14px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: all 0.3s ease;
    letter-spacing: 0.3px;
    text-transform: lowercase;
  }

  .contact-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: 0 0 12px var(--color-glow);
  }

  .contact-icon { font-size: 0.85rem; }

  /* PROJECTS TOOLBAR */
  .projects-toolbar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .search-box {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    transition: all 0.3s ease;
  }

  .search-box:focus-within {
    border-color: var(--color-accent);
    box-shadow: 0 0 12px var(--color-glow);
  }

  .search-icon {
    color: var(--color-text-dim);
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    font-family: inherit;
    font-size: 0.75rem;
    color: var(--color-text);
  }

  .search-input::placeholder { color: var(--color-text-dim); }

  .search-hint {
    color: var(--color-text-dim);
    font-size: 0.55rem;
    opacity: 0;
    transition: opacity 0.3s;
    flex-shrink: 0;
  }

  .search-box:focus-within .search-hint { opacity: 0.6; }

  .search-count {
    color: var(--color-text-muted);
    font-size: 0.6rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* PROJECTS GRID */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  /* FOOTER */
  .footer {
    padding: 32px 0 16px;
    text-align: center;
  }

  .footer-divider {
    font-size: 0.6rem;
    color: var(--color-text-dim);
    letter-spacing: 1.5px;
    padding: 16px 0;
    text-transform: uppercase;
    position: relative;
  }

  .footer-divider::before,
  .footer-divider::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 25%;
    height: 1px;
    background: var(--color-border);
  }

  .footer-divider::before { left: 0; }
  .footer-divider::after { right: 0; }

  .footer-text {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 300;
    margin-bottom: 4px;
  }

  .footer-accent {
    color: var(--color-accent);
    font-weight: 600;
  }

  .footer-sep {
    margin: 0 8px;
    color: var(--color-text-dim);
  }

  .footer-sub {
    font-size: 0.6rem;
    color: var(--color-text-dim);
    font-weight: 300;
  }

  /* STATS ROW */
  .stats-row {
    display: flex;
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 24px;
    transition: border-color 0.3s;
  }

  .stat-cell {
    flex: 1;
    text-align: center;
    padding: 8px;
  }

  .metrics-card {
    border: 1px solid var(--color-border-strong);
    border-radius: 8px;
    padding: 16px;
    background: var(--color-bg-elevated);
    backdrop-filter: blur(4px);
    display: flex;
    justify-content: center;
    margin-bottom: 24px;
  }

  .metrics-img {
    width: 100%;
    max-width: 500px;
    height: auto;
    display: block;
  }

  .stat-number {
    display: block;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1.2;
    transition: color 0.3s;
  }

  .stat-desc {
    display: block;
    font-size: 0.6rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-top: 4px;
  }

  /* CONTACT SECTION */
  .contact-section {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 28px;
    transition: border 0.3s;
  }

  .contact-section:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 20px var(--color-glow);
  }

  .contact-intro {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 300;
    margin-bottom: 20px;
    line-height: 1.6;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .contact-channels {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    align-content: start;
  }

  .channel-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    background: rgba(0, 0, 0, 0.15);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.3s;
  }

  .channel-card:hover {
    border-color: var(--color-accent);
    background: rgba(0, 0, 0, 0.25);
  }

  .location-card { cursor: default; }
  .location-card:hover { border-color: var(--color-border); background: rgba(0, 0, 0, 0.15); }

  .channel-icon {
    font-size: 1.1rem;
    color: var(--color-accent);
    flex-shrink: 0;
    width: 24px;
    text-align: center;
  }

  .channel-label {
    font-size: 0.6rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    min-width: 56px;
    flex-shrink: 0;
  }

  .channel-value {
    font-size: 0.72rem;
    color: var(--color-text);
    font-weight: 400;
    word-break: break-all;
  }

  .channel-card:hover .channel-value {
    color: var(--color-accent);
  }

  .location-card:hover .channel-value {
    color: var(--color-text);
  }

  /* MESSAGE FORM */
  .message-form {
    background: rgba(0, 0, 0, 0.12);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 20px;
    transition: border 0.3s;
  }

  .message-form:hover {
    border-color: var(--color-accent);
  }

  .form-title {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 12px;
  }

  .form-label {
    font-size: 0.6rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .form-input {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 8px 12px;
    font-family: inherit;
    font-size: 0.78rem;
    color: var(--color-text);
    transition: all 0.3s;
    outline: none;
  }

  .form-input::placeholder {
    color: var(--color-text-dim);
    font-weight: 300;
  }

  .form-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 8px var(--color-glow);
  }

  .form-textarea {
    resize: vertical;
    min-height: 80px;
  }

  .form-submit {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 20px;
    background: transparent;
    border: 1px solid var(--color-accent);
    border-radius: 4px;
    color: var(--color-accent);
    font-family: inherit;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: all 0.3s;
  }

  .form-submit:hover {
    background: var(--color-accent-dim);
    box-shadow: 0 0 12px var(--color-glow);
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .projects-toolbar { flex-direction: column; align-items: stretch; }
    .search-hint { display: none; }
  }

  @media (max-width: 768px) {
    .section { padding: 32px 0; }
    .nav-links { gap: 0; }
    .nav-link { font-size: 0.6rem; padding: 4px 8px; }
  }

  @media (max-width: 800px) {
    .contact-layout { grid-template-columns: 1fr; }
    .form-row { grid-template-columns: 1fr; }
  }

